# DB Buddy — environment configuration template.
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# See docs/DEPLOYMENT.md and docs/SECURITY.md for details.

# ── Deployment mode ───────────────────────────────────────────────────────────
# development (default) | production | test.
# In `production` the app FAILS TO START unless JWT_SECRET, APP_SECRET_KEY, a
# non-SQLite APP_DATABASE_URL, and ALLOWED_ORIGINS are all explicitly set.
DBBUDDY_ENV=development

# ── Application database (platform state: users, roles, charts, audit) ─────────
# Production target is PostgreSQL. Dev default is a local SQLite file.
# APP_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dbbuddy_app

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Must be >= 32 bytes (a shorter value aborts startup). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ── At-rest encryption key (Fernet) for ERP passwords + MFA secrets ───────────
# Set this even in dev — otherwise the key is ephemeral and rotates on every
# restart, orphaning saved connection/MFA secrets.
# APP_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins. NEVER "*". Defaults to the local
# dev frontend when unset.
# ALLOWED_ORIGINS=https://dbbuddy.example.org,https://analytics.example.org

# ── First admin (provisioned on startup if both set and no such user exists) ──
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=

# ── Self-registration ─────────────────────────────────────────────────────────
# Optional email-domain allow-list for POST /auth/register. Empty (default) keeps
# self-registration open; set it to confine new self-service accounts to trusted
# domains. Registration is IP-rate-limited regardless.
# REGISTRATION_ALLOWED_DOMAINS=example.org,corp.example.org

# ── Rotating the at-rest encryption key ───────────────────────────────────────
# Keys this deployment has retired but whose ciphertext may still be stored.
# Newest first, comma-separated. Everything is encrypted with APP_SECRET_KEY and
# decrypted with whichever of these fits, which is what makes rotation a
# procedure rather than data loss:
#
#   1. move the old value here, put the new one in APP_SECRET_KEY
#   2. python scripts/rotate_secrets.py --dry-run   (check every row decrypts)
#   3. python scripts/rotate_secrets.py             (re-encrypt at rest)
#   4. remove the old value from this list
#
# Skipping step 3 destroys every stored ERP password, AI provider key and MFA
# secret.
# APP_SECRET_KEYS_PREVIOUS=

# ── Email verification ────────────────────────────────────────────────────────
# Off by default: enforcing it would change what every existing install, the
# Docker demo and every developer setup already do. Turn it on for a hosted
# deployment that wants proof of address. When on, an account can be created but
# cannot sign in until the address is confirmed. Accounts that predate the feature
# are grandfathered as verified by migration 0017 — turning this on must not lock
# out a user base that registered under the old rules.
# REQUIRE_EMAIL_VERIFICATION=0
# EMAIL_VERIFICATION_TTL_HOURS=48

# ── Email / password reset ────────────────────────────────────────────────────
# Password reset needs to send a link. With SMTP_HOST unset the link is written to
# the log instead of sent — which is what you want locally, and is why a fresh
# install does not appear broken. Set SMTP_HOST to actually deliver.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=1
# EMAIL_FROM=no-reply@example.org
#
# Where the frontend lives; the reset link is built from it. Defaults to the dev
# frontend, matching ALLOWED_ORIGINS.
# APP_BASE_URL=https://dbbuddy.example.org
#
# How long a reset link stays usable. Short on purpose — it is a bearer credential
# sitting in an inbox, and the flow takes a minute.
# PASSWORD_RESET_TTL_MINUTES=30

# ── Background scheduler ──────────────────────────────────────────────────────
# Set to 1 to disable the in-process job scheduler (e.g. on extra workers/tests).
# DBBUDDY_DISABLE_SCHEDULER=0

# ── AI providers (labeling only) ──────────────────────────────────────────────
# Providers are managed in-app as per-org records (Settings -> AI Providers), not
# here. OLLAMA_URL is the default endpoint for a local Ollama provider record;
# NEMOTRON_MODEL / OPENAI_MODEL are legacy defaults used only when migrating an
# existing keyring/env key into a record on first start.
# OLLAMA_URL=http://127.0.0.1:11434
# NEMOTRON_MODEL=
# OPENAI_MODEL=gpt-4o-mini
# Local Ollama labeling: Ollama defaults its context window to 2048 tokens
# regardless of the model's real capacity, which truncates the JSON reply when
# labeling a wide schema (hundreds of columns) and silently drops the whole
# batch to rule-based. These raise the window/reply budget to the model's
# capacity; lower them for a small local model. LOCAL_CLASSIFY_CHUNK bounds how
# many columns are classified per request so no single reply can overflow.
# OLLAMA_NUM_CTX=16384
# OLLAMA_NUM_PREDICT=4096
# LOCAL_CLASSIFY_CHUNK=30

# ── AI provider resilience (retries, backoff, circuit breaker) ────────────────
# Defaults are sensible; override only to tune the labeling path's behavior.
# Retries: attempts per provider before failing over to its fallback, exponential
# backoff bounds, and the cap above which a server Retry-After fails over instead
# of blocking.
# AI_RETRY_MAX_ATTEMPTS=3
# AI_RETRY_BASE_DELAY=0.5
# AI_RETRY_MAX_DELAY=8
# AI_RETRY_AFTER_CAP=8
# Circuit breaker: consecutive transient failures before a provider is tripped
# open (skipped to fallback), and the cooldown bounds (grows on repeated trips).
# AI_BREAKER_THRESHOLD=5
# AI_BREAKER_COOLDOWN=60
# AI_BREAKER_MAX_COOLDOWN=300

# ── Insights Engine (analyst-only, evidence-bound result analysis) ────────────
# Master switch. Off → /insights/* returns 503 with a clear reason.
# INSIGHTS_ENABLED=1
# Sampling temperature. Deliberately low — this is analysis, not prose. Provider
# *selection* is not configured here: insights use the org's AI provider chain.
# INSIGHTS_TEMPERATURE=0.2
# Bounds on the evidence packet sent to the model. Statistics still cover every
# row supplied; these cap only what is quoted verbatim. Lower them if a provider
# rejects the prompt for length.
# INSIGHTS_MAX_SAMPLE_ROWS=20
# INSIGHTS_MAX_COLUMNS=40
# INSIGHTS_MAX_CELL_CHARS=120
# Bounds on the client-supplied follow-up transcript (attacker-controlled input).
# INSIGHTS_MAX_HISTORY_TURNS=8
# INSIGHTS_MAX_TURN_CHARS=1000
# Cached-bundle lifetime; a stale entry regenerates in place. 0 disables expiry.
# INSIGHTS_CACHE_TTL_HOURS=24

# ── Per-DB context / schema caching (query latency) ───────────────────────────
# Resolving the prepared context re-reads the schema to detect a DDL change (the
# schema-aware cache key). On a wide ERP schema that read is the largest
# per-query cost, and a dashboard opening N charts pays it N times in a burst.
# This caches the resolved schema for a few seconds so a burst collapses to one
# read; a schema change is still seen within the TTL, and Analyze / rebuild /
# connection edits invalidate it immediately. Set 0 to always re-read (the prior
# behavior). Reported at GET /context-metrics as schema_fetches_cached.
# SCHEMA_CACHE_TTL_SECONDS=5

# ── Protecting the customer's ERP (timeouts + backpressure) ───────────────────
# Ceiling on any single statement against a customer database, in seconds.
# Without it a lock wait or a 400M-row scan holds a worker indefinitely.
# PostgreSQL/MySQL enforce it server-side; SQL Server has no session equivalent.
# ERP_STATEMENT_TIMEOUT=60
# Concurrent queries allowed against ONE target database. This protects the
# customer's ERP from DB Buddy's own popularity. Per process — with N workers the
# effective ceiling is N x this, so use desired_total / worker_count.
# ERP_MAX_CONCURRENT_QUERIES=10
# How long a query waits for a slot before failing with "busy, try again"
# (HTTP 503 + Retry-After, distinct from 502 "unreachable").
# ERP_QUEUE_TIMEOUT=20
# NOTE: this ceiling is what actually bounds concurrent ERP connections. The
# internal connection pool caps only *idle* connections, so with the semaphore
# raised very high the server will open one session per in-flight request.

# ── Auth hardening ────────────────────────────────────────────────────────────
# Number of uvicorn worker processes. Consulted ONLY while Redis is unavailable,
# to shrink each worker's local login-throttle cap so the processes together stay
# near the configured global limit instead of N times it. The login throttle is
# Redis-backed and shared when Redis is up; when it is not, it degrades to a
# STRICTER local window rather than disappearing. Default 1 = unchanged behavior.
# LOGIN_GUARD_WORKERS=1
# Access tokens carry a `tv` claim mirroring User.token_version, so logout /
# deactivation / MFA-disable invalidate them too — not just refresh tokens. The
# check is served from a short in-process cache so the hot query path still does
# no per-request app-DB read. Seconds; sites that bump token_version invalidate
# the entry explicitly, so this only bounds *external* DB edits.
# AUTH_REVOCATION_CACHE_TTL=10

# Refuse AI-provider base_urls that resolve to loopback / RFC1918 addresses.
# OFF by default because the normal deployment runs Ollama on localhost and
# self-hosted models on the LAN. Turn it ON (=1) for any hosted / multi-tenant
# deployment, where a tenant admin is untrusted relative to the server's network.
# Cloud instance-metadata (link-local, e.g. 169.254.169.254) is ALWAYS refused,
# regardless of this setting.
# AI_PROVIDER_BLOCK_PRIVATE_NETWORKS=0

# ── Background jobs ───────────────────────────────────────────────────────────
# Window in which two fires of the same job count as the same fire, so a job
# does not run once per worker process.
# JOB_FIRE_DEDUPE_SECONDS=30

# ── Dashboards (collections of charts, refreshed live) ────────────────────────
# Cached chart-result lifetime when a dashboard is opened. Short by design; each
# chart reports its own fetched_at and Refresh always bypasses the cache.
# DASHBOARD_CACHE_TTL_SECONDS=45
# How many of a dashboard's charts may query concurrently. Bounded so one wide
# dashboard cannot flood a customer database with connections.
# DASHBOARD_MAX_PARALLEL_QUERIES=6
# Maximum charts in one dashboard — opening it runs every one of them.
# DASHBOARD_MAX_CHARTS=40
# Hard ceiling on rows for a single chart. A chart is a visual; 200k points are
# not legible, and one uncapped chart measured 47 MB. Truncation is disclosed.
# CHART_MAX_ROWS=5000
# Results above this are returned but not cached (Redis is not a blob store).
# CHART_MAX_CACHEABLE_ROWS=2000

# ── Redis (optional everywhere; absence degrades to computing live) ───────────
# Bounds on the handshake and on each command. Without them an absent Redis —
# the default deployment — blocked the request path for ~49 s.
# REDIS_CONNECT_TIMEOUT=0.5
# REDIS_SOCKET_TIMEOUT=2
# For a Redis that dies *after* startup: the connect probe only proves it was up
# once, so without a gate every later call still pays REDIS_SOCKET_TIMEOUT. After
# this many consecutive errors the client stops calling out, then retries one
# command after the cooldown to notice recovery.
# REDIS_ERROR_THRESHOLD=3
# REDIS_RECOVERY_SECONDS=30

# ── Vector store ──────────────────────────────────────────────────────────────
# Where schema embeddings persist. Put this on a durable volume in production:
# losing it forces a full re-embed on the next Analyze Schema.
# CHROMADB_PERSIST_DIRECTORY=./chroma_db

# ── Frontend build ────────────────────────────────────────────────────────────
# Base URL the frontend calls (Vite build-time).
# VITE_API_BASE=http://127.0.0.1:8000
