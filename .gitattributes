# Normalize line endings to LF in the repo and on checkout for all text files.
# Keeps Prettier (which enforces LF) and Git consistent on Windows/macOS/Linux,
# preventing the recurring "Delete ␍ (CR)" lint failures caused by core.autocrlf.
* text=auto eol=lf

# Explicit text types (belt-and-suspenders for editors that guess).
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh   text eol=lf

# Binary assets — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
